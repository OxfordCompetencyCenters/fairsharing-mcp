# FAIRsharing API Configuration
# Get your API key from https://fairsharing.org/users/sign_in (after registration)

FAIRSHARING_API_KEY=your-api-key-here

# Optional: Custom API URL (defaults to https://api.fairsharing.org/graphql/)
# FAIRSHARING_API_URL=https://api.fairsharing.org/graphql/

# --- FAIRsharing MCP — limits (optional; see TRUNCATION_AND_ENV_AUDIT.md) ---
# All three are valid and in use. They do not remove limits; they configure caps and visibility.

# Max results per page for search and scan-based tools. Default 50; code enforces 1–50 (API cap).
# FAIRSHARING_MAX_PER_PAGE=50

# Max records to scan for date filtering (API has no date filter; we scan pages). Default 2000; max 50000.
# To maximize date-filtered results, set to 10000 or 50000 (more requests/time; may hit timeouts).
# FAIRSHARING_MAX_SCAN=2000
# FAIRSHARING_MAX_SCAN=10000
# FAIRSHARING_MAX_SCAN=50000

# Tool output includes "results may be truncated" / "scan limited to X" messages by default.
# Set to 0 or false to disable (opt-out). Default: true (warnings shown).
# FAIRSHARING_TRUNCATION_WARNING=1
# FAIRSHARING_TRUNCATION_WARNING=0

# --- Display limits (optional; 0 = no limit). See config.get_display_limit() in config.py ---
# FAIRSHARING_DISPLAY_MAX_ASSOCIATIONS=20
# FAIRSHARING_DISPLAY_MAX_ORGANISATIONS=10
# FAIRSHARING_DISPLAY_MAX_PUBLICATIONS=10
# FAIRSHARING_DISPLAY_MAX_TAXONOMIES=20
# FAIRSHARING_DISPLAY_MAX_SUBJECTS=5
# FAIRSHARING_DISPLAY_MAX_DOMAINS=5
# FAIRSHARING_DISPLAY_MAX_CHILDREN=30
# FAIRSHARING_DISPLAY_MAX_RECOMMENDED=30
# FAIRSHARING_DISPLAY_MAX_DESCRIPTION_CHARS=300

# Cap on association entries embedded in fairsharing_get_record's JSON output.
# Counts (association_counts) stay exact regardless. Default 100; 0 = no cap.
# A single record can carry 1,000+ associations, so raising this can be expensive.
# FAIRSHARING_DISPLAY_MAX_JSON_ASSOCIATIONS=100

# Per (relationship, registry) group cap in fairsharing_analyze_record_ecosystem.
# Group counts stay exact regardless. Default 15; 0 = show all.
# FAIRSHARING_DISPLAY_MAX_ECOSYSTEM_GROUP=15

# NOTE: these display limits are honoured by formatters.py and the two tools above.
# Most other tool modules use hardcoded caps that no environment variable affects.
# For guaranteed-complete association data, use fairsharing_list_associations.

# --- LLM Client Configuration (for `python -m clients`) ---

# LLM provider: "openai" (default) or "anthropic" (not yet implemented)
# LLM_PROVIDER=openai

# Model to use (default: gpt-5.3-chat-latest)
# LLM_MODEL=gpt-5.3-chat-latest

# OpenAI API key (required when LLM_PROVIDER=openai)
OPENAI_API_KEY=your-openai-api-key-here

# Custom LLM endpoint — for OpenAI-compatible proxies (e.g. Lagrange)
# Leave unset to use OpenAI's default endpoint.
# OPENAI_BASE_URL=https://lagrange.uksouth.cloudapp.azure.com/openai/

# Anthropic API key (required when LLM_PROVIDER=anthropic)
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# MCP server command overrides (defaults: uv / run,fairsharing-mcp)
# MCP_SERVER_COMMAND=uv
# MCP_SERVER_ARGS=run,fairsharing-mcp

# MCP transport: "stdio" (default, local subprocess) or "streamable-http" (remote HTTP endpoint)
# MCP_TRANSPORT=stdio

# MCP server URL (required only when MCP_TRANSPORT=streamable-http)
# MCP_SERVER_URL=https://your-mcp-server.azurewebsites.net/mcp

# Conversation log directory (default: /home/LogFiles/conversations on Azure, logs/conversations locally)
# CONVERSATION_LOG_DIR=/home/LogFiles/conversations
